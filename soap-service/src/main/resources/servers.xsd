<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com/soap/servers"
           targetNamespace="http://example.com/soap/servers"
           elementFormDefault="qualified">

    <!-- Type Server -->
    <xs:complexType name="Server">
        <xs:sequence>
            <xs:element name="id" type="xs:long" minOccurs="0"/>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="ipAddress" type="xs:string"/>
            <xs:element name="status" type="xs:boolean"/>
        </xs:sequence>
    </xs:complexType>

    <!-- 1. CreateServer -->
    <xs:element name="CreateServerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="name" type="xs:string"/>
                <xs:element name="ipAddress" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="CreateServerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="server" type="tns:Server"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 2. ListServers -->
    <xs:element name="ListServersRequest">
        <xs:complexType/>
    </xs:element>

    <xs:element name="ListServersResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="servers" type="tns:Server" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 3. RenameServer -->
    <xs:element name="RenameServerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
                <xs:element name="newName" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="RenameServerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="server" type="tns:Server"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 4. GetServerStatus -->
    <xs:element name="GetServerStatusRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetServerStatusResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 5. StartServer -->
    <xs:element name="StartServerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="StartServerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="server" type="tns:Server"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 6. StopServer -->
    <xs:element name="StopServerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="StopServerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="server" type="tns:Server"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 7. DeleteServer -->
    <xs:element name="DeleteServerRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="DeleteServerResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>